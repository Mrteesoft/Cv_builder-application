<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">



    <!-- Progress Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progress"
                android:textSize="16sp"
                android:textColor="#333333"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25%"
                android:textSize="16sp"
                android:textColor="#4A90E2"
                android:textStyle="bold" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="25"
            android:max="100"
            android:progressTint="#4A90E2"
            android:progressBackgroundTint="#E0E0E0" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp"
        android:background="#FAFAFA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Personal Information Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal Information"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"
                        android:layout_marginBottom="20dp" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Full Name"
                        android:textSize="16sp"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#999999"
                        android:background="@drawable/edit_text_background"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:hint="Email Address"
                            android:textSize="16sp"
                            android:textColor="#1A1A1A"
                            android:textColorHint="#999999"
                            android:background="@drawable/edit_text_background"
                            android:padding="16dp"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/btnSuggestEmail"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:text="✨"
                            android:textSize="18sp"
                            android:background="@drawable/ai_button_background"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:hint="Phone Number"
                            android:textSize="16sp"
                            android:textColor="#1A1A1A"
                            android:textColorHint="#999999"
                            android:background="@drawable/edit_text_background"
                            android:padding="16dp"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/btnSuggestPhone"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:text="✨"
                            android:textSize="18sp"
                            android:background="@drawable/ai_button_background"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etLinkedIn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="LinkedIn/GitHub URL"
                        android:textSize="16sp"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#999999"
                        android:background="@drawable/edit_text_background"
                        android:padding="16dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Professional Summary Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Professional Summary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="16dp" />

                    <EditText
                        android:id="@+id/etSummary"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:hint="Write a brief summary about yourself..."
                        android:textSize="16sp"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#999999"
                        android:background="@drawable/edit_text_background"
                        android:padding="16dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/btnSuggestSummary"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="✨ Generate with AI"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#4A90E2"
                        android:background="@drawable/ai_button_full_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Work Experience Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Work Experience"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/etJobTitle"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:hint="Job Title"
                            android:background="@drawable/edit_text_background"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/btnSuggestJobTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="✨"
                            android:textSize="16sp"
                            android:background="@drawable/ai_button_background"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etCompanyName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Company Name"
                        android:background="@drawable/edit_text_background"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/etStartDate"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:hint="Start Date"
                            android:background="@drawable/edit_text_background"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp" />

                        <EditText
                            android:id="@+id/etEndDate"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:hint="End Date"
                            android:background="@drawable/edit_text_background"
                            android:padding="12dp"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etResponsibilities"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:hint="Key responsibilities and achievements..."
                        android:background="@drawable/edit_text_background"
                        android:padding="12dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/btnSuggestResponsibilities"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="✨ Suggest based on job title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#4A90E2"
                        android:background="@drawable/ai_button_full_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#F8F9FA">

        <TextView
            android:id="@+id/btnSaveDraft"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Save Draft"
            android:textColor="#4A90E2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_secondary"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnPreview"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Preview CV"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>