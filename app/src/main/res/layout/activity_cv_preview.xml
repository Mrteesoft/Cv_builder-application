<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Modern Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/chat_header_gradient"
        android:paddingBottom="20dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_back_white"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="16dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CV PREVIEW"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textAllCaps="true" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="horizontal"
            android:padding="24dp">

            <!-- Left Column - Main Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical"
                android:paddingEnd="20dp">

                <!-- Header Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="32dp">

                    <TextView
                        android:id="@+id/txtPreviewName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Name"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="4dp">

                        <TextView
                            android:id="@+id/txtPreviewEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="your.email@example.com"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/txtPreviewPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+1 (555) 123-4567"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/txtPreviewAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="City, State"
                            android:textSize="14sp"
                            android:textColor="#666666" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Professional Summary -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROFESSIONAL SUMMARY"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="50dp"
                        android:layout_height="2dp"
                        android:background="#3F51B5"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/txtPreviewSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Professional summary showcasing your skills and experience in your field."
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:lineSpacingMultiplier="1.4"
                        android:justificationMode="inter_word" />

                </LinearLayout>

                <!-- Work Experience -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WORK EXPERIENCE"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="50dp"
                        android:layout_height="2dp"
                        android:background="#3F51B5"
                        android:layout_marginBottom="16dp" />

                    <!-- Job Entry -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:id="@+id/txtJobTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Job Title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/txtCompanyDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Company Name • 2020 - Present"
                            android:textSize="13sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/txtResponsibilities"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• Key responsibility or achievement\n• Another important accomplishment\n• Third major contribution"
                            android:textSize="13sp"
                            android:textColor="#333333"
                            android:lineSpacingMultiplier="1.4"
                            android:paddingStart="12dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Right Column - Sidebar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:orientation="vertical"
                android:background="#FAFAFA"
                android:padding="20dp">

                <!-- Skills Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SKILLS"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="2dp"
                        android:background="#3F51B5"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/txtSkills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Technical Skills\n• Communication\n• Problem Solving\n• Leadership\n• Project Management"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>

                <!-- Education Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EDUCATION"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="2dp"
                        android:background="#3F51B5"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/txtDegree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Degree Name"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/txtSchool"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="University Name"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/txtGradDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Graduation Year"
                        android:textSize="11sp"
                        android:textColor="#666666" />

                </LinearLayout>

                <!-- Languages Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LANGUAGES"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="2dp"
                        android:background="#3F51B5"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/txtLanguages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• English (Native)\n• Spanish (Fluent)\n• French (Basic)"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Edit"
            android:textColor="#666666"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_secondary" />

        <Button
            android:id="@+id/btnSavePDF"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Download PDF"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/button_primary" />
            
        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Share"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_primary" />

    </LinearLayout>

</LinearLayout>